    "Video, audio, behavior and appearance go back to their defaults. Keymaps and recordings are not touched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, audio, behavior and appearance go back to their defaults. Keymaps and recordings are not touched."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, audio, perilaku, dan tampilan kembali ke bawaan. Keymap dan rekaman tidak disentuh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo, el audio, el comportamiento y la apariencia vuelven a sus valores predeterminados. Los mapas de teclas y las grabaciones no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo, l’audio, le comportement et l’apparence reviennent à leurs valeurs par défaut. Les configurations et les enregistrements ne sont pas touchés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, Audio, Verhalten und Erscheinungsbild gehen auf ihre Standardwerte zurück. Tastenbelegungen und Aufnahmen bleiben unberührt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeo, áudio, comportamento e aparência voltam aos padrões. Mapas de teclas e gravações não são tocados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频、音频、行为和外观将恢复默认值。键位映射和录制内容不受影响。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ、オーディオ、動作、外観がデフォルトに戻ります。キーマップと録画には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오, 오디오, 동작, 화면 스타일이 기본값으로 돌아갑니다. 키맵과 녹화본은 건드리지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео, звук, поведение и оформление вернутся к значениям по умолчанию. Раскладки и записи не затрагиваются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, ses, davranış ve görünüm varsayılanlarına döner. Tuş haritalarına ve kayıtlara dokunulmaz."
          }
        }
      }
    },
