    },
    "The app restarts and comes back in the new language. A recording in progress is saved first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app restarts and comes back in the new language. A recording in progress is saved first."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi dimulai ulang dan kembali dalam bahasa baru. Rekaman yang sedang berjalan disimpan dulu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se reinicia y vuelve en el nuevo idioma. Una grabación en curso se guarda primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app redémarre et revient dans la nouvelle langue. Un enregistrement en cours est d’abord sauvegardé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App startet neu und kommt in der neuen Sprache zurück. Eine laufende Aufnahme wird zuvor gesichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app reinicia e volta no novo idioma. Uma gravação em andamento é salva primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用将重新启动并以新语言回来。正在进行的录制会先保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが再起動し、新しい言語で戻ります。録画中の場合は先に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다시 시작되어 새 언어로 돌아옵니다. 진행 중인 녹화는 먼저 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение перезапустится и вернётся на новом языке. Идущая запись сначала сохранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama yeniden başlar ve yeni dille geri gelir. Süren bir kayıt önce kaydedilir."
          }
        }
      }
    },
