    "Copy the databases again every two seconds and refresh when they change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the databases again every two seconds and refresh when they change"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin ulang database tiap dua detik dan segarkan saat berubah"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia las bases de datos cada dos segundos y actualiza cuando cambien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recopie les bases de données toutes les deux secondes et actualise quand elles changent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert die Datenbanken alle zwei Sekunden neu und aktualisiert bei Änderungen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia os bancos de dados de novo a cada dois segundos e atualiza quando mudarem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每两秒重新复制一次数据库，并在变化时刷新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースを 2 秒ごとにコピーし直し、変更があれば更新します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스를 2초마다 다시 복사하고 변경되면 새로 고칩니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирует базы данных заново каждые две секунды и обновляет при изменениях"
