    "The phone blocks installs over USB. Turn on “Install via USB” in Developer options.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone blocks installs over USB. Turn on “Install via USB” in Developer options."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel memblokir pemasangan lewat USB. Aktifkan “Instal via USB” di Opsi pengembang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono bloquea las instalaciones por USB. Activa “Instalar vía USB” en Opciones de desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone bloque les installations par USB. Activez « Installer via USB » dans les Options pour les développeurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon blockiert Installationen über USB. Aktiviere „Über USB installieren“ in den Entwickleroptionen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular bloqueia instalações por USB. Ative “Instalar via USB” em Opções do desenvolvedor."
          }
        }
      }
