    "Only for games that have a keymap. Off: modes change only when you change them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for games that have a keymap. Off: modes change only when you change them."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk game yang punya keymap. Mati: mode hanya berubah saat kamu mengubahnya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para juegos que tengan un mapa de teclas. Desactivado: los modos cambian solo cuando tú los cambias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les jeux qui ont une configuration. Désactivé : les modes ne changent que si vous les changez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Spiele mit Tastenbelegung. Aus: Modi wechseln nur, wenn du sie wechselst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para jogos que têm mapa de teclas. Desligado: os modos só mudam quando você os muda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于有键位映射的游戏。关闭后，模式只在你切换时才会改变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーマップのあるゲーム専用です。オフ：モードは手動で切り替えたときだけ変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키맵이 있는 게임 전용입니다. 끄면 모드는 직접 바꿀 때만 바뀝니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для игр, у которых есть раскладка. Выкл.: режимы меняются только когда вы их меняете."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tuş haritası olan oyunlar için. Kapalı: modlar yalnızca siz değiştirdiğinizde değişir."
          }
        }
      }
    },
