    "Enter your screen lock if the phone asks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your screen lock if the phone asks."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kunci layar jika ponsel memintanya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el bloqueo de pantalla si el teléfono lo pide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le verrouillage d’écran si le téléphone le demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Bildschirmsperre ein, falls das Telefon danach fragt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o bloqueio de tela se o celular pedir."
          }
        },
        "zh-Hans": {
