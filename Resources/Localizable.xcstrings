    "Lower is faster. Raise it if sound crackles. Applies the next time you connect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower is faster. Raise it if sound crackles. Applies the next time you connect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makin rendah makin cepat. Naikkan jika suara pecah. Berlaku saat sambung berikutnya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos es más rápido. Súbelo si el sonido crepita. Se aplica la próxima vez que te conectes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus bas, plus rapide. Augmentez si le son crépite. S’applique à la prochaine connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger ist schneller. Erhöhe es, wenn der Ton knistert. Gilt ab der nächsten Verbindung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menor é mais rápido. Aumente se o som estalar. Vale na próxima vez que você conectar."
          }
        }
      }
    },
