    "Apps on the phone lose the internet until you turn it back on. It is switched back on when you disconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps on the phone lose the internet until you turn it back on. It is switched back on when you disconnect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi di ponsel kehilangan internet sampai Anda menyalakannya lagi. Koneksi dinyalakan kembali saat Anda memutus koneksi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps del teléfono no tendrán internet hasta que lo vuelvas a activar. Se reactiva al desconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps du téléphone n’auront plus internet tant que vous ne le réactivez pas. Il est réactivé à la déconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps auf dem Telefon haben kein Internet, bis du es wieder einschaltest. Beim Trennen wird es wieder eingeschaltet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps do celular ficam sem internet até você ativá-la de novo. Ela é reativada ao desconectar."
          }
        }
      }
    },
    "Ask before discarding keymap changes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
