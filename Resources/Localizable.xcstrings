        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo, el audio, el comportamiento y la apariencia vuelven a sus valores predeterminados. Los mapas de teclas y las grabaciones no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo, l’audio, le comportement et l’apparence reviennent à leurs valeurs par défaut. Les configurations et les enregistrements ne sont pas touchés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, Audio, Verhalten und Erscheinungsbild gehen auf ihre Standardwerte zurück. Tastenbelegungen und Aufnahmen bleiben unberührt."
