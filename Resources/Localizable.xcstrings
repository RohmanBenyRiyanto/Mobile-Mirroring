    "Video, audio, behavior and appearance go back to their defaults. Keymaps and recordings are not touched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, audio, behavior and appearance go back to their defaults. Keymaps and recordings are not touched."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, audio, perilaku, dan tampilan kembali ke bawaan. Keymap dan rekaman tidak disentuh."
          }
