    "Restart to change the language?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart to change the language?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai ulang untuk mengganti bahasa?"
          }
        },
