    "Frame rate and jank come from the app in front. Games that draw on their own may show none.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate and jank come from the app in front. Games that draw on their own may show none."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate dan jank berasal dari aplikasi yang sedang tampil. Game yang menggambar sendiri mungkin tidak menampilkannya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fps y los tirones vienen de la app en primer plano. Los juegos que dibujan por su cuenta pueden no mostrar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fréquence d’images et les saccades viennent de l’app au premier plan. Les jeux qui dessinent eux-mêmes peuvent n’en montrer aucune."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildrate und Ruckler stammen von der App im Vordergrund. Spiele, die selbst zeichnen, zeigen evtl. keine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de quadros e as travadas vêm do app em primeiro plano. Jogos que desenham por conta própria podem não mostrar nenhuma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧率和卡顿数据来自前台应用。自行绘制画面的游戏可能没有数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームレートとカクつきは、前面のアプリから取得します。独自に描画するゲームでは表示されないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 속도와 끊김은 앞에 있는 앱에서 가져옵니다. 직접 그리는 게임에서는 표시되지 않을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота кадров и рывки берутся из приложения на переднем плане. Игры, рисующие сами, могут их не показывать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kare hızı ve takılmalar öndeki uygulamadan gelir. Kendi çizimini yapan oyunlar hiçbir şey göstermeyebilir."
          }
        }
      }
    },
    "GIFs are small and short. The picture is shrunk to fit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs are small and short. The picture is shrunk to fit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF itu kecil dan pendek. Gambar akan diperkecil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los GIF son pequeños y cortos. La imagen se reduce para que quepa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les GIF sont petits et courts. L’image est réduite pour tenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs sind klein und kurz. Das Bild wird verkleinert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs são pequenos e curtos. A imagem é reduzida para caber."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 小而短。画面会缩小以适应。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF は小さく短くなります。画像は収まるように縮小されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF는 작고 짧습니다. 그림은 맞게 축소됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF маленькие и короткие. Картинка уменьшается, чтобы поместиться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF'ler küçük ve kısadır. Resim sığacak şekilde küçültülür."
          }
        }
      }
    },
