    "Quitting now would leave the video unfinished. Stop the recording and save it first?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now would leave the video unfinished. Stop the recording and save it first?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar sekarang akan membuat video tidak selesai. Hentikan rekaman dan simpan dulu?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales ahora, el vídeo quedará sin terminar. ¿Detener la grabación y guardarla primero?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter maintenant laisserait la vidéo inachevée. Arrêter l’enregistrement et l’enregistrer d’abord ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden würde das Video unvollendet lassen. Aufnahme stoppen und zuerst sichern?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair agora deixaria o vídeo inacabado. Parar a gravação e salvá-la primeiro?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在退出会使视频不完整。先停止录制并保存吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今終了すると動画が未完成になります。録画を停止して先に保存しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 종료하면 동영상이 완성되지 않습니다. 녹화를 중지하고 먼저 저장할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выйти сейчас, видео останется незавершённым. Остановить запись и сначала сохранить её?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi çıkmak videoyu yarım bırakır. Önce kaydı durdurup kaydedelim mi?"
          }
        }
      }
    },
