    "Unplug the cable and plug it in again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplug the cable and plug it in again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabut kabel lalu colokkan lagi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta el cable y vuelve a conectarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débranchez le câble et rebranchez-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe das Kabel ab und stecke es wieder ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecte o cabo e conecte de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拔下数据线再插上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケーブルを抜いて差し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케이블을 뽑았다가 다시 꽂으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсоедините кабель и подключите снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabloyu çıkarıp tekrar takın."
          }
        }
      }
    },
    "Unplug the cable, plug it in again, then unlock the phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplug the cable, plug it in again, then unlock the phone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabut kabel, colokkan lagi, lalu buka kunci ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta el cable, vuelve a conectarlo y desbloquea el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débranchez le câble, rebranchez-le, puis déverrouillez le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe das Kabel ab, stecke es wieder ein und entsperre dann das Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecte o cabo, conecte de novo e depois desbloqueie o celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拔下数据线，再插上，然后解锁手机。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケーブルを抜いて差し直し、スマートフォンのロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케이블을 뽑았다가 다시 꽂은 뒤 휴대전화 잠금을 해제하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсоедините кабель, подключите снова, затем разблокируйте телефон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabloyu çıkarın, tekrar takın, sonra telefonun kilidini açın."
          }
        }
      }
    },
    "Untick Local File. Paste the address into Input and set Input Format to mpegts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untick Local File. Paste the address into Input and set Input Format to mpegts."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus centang Local File. Tempel alamat ke Input dan atur Input Format ke mpegts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca Local File. Pega la dirección en Input y pon Input Format en mpegts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décochez Local File. Collez l’adresse dans Input et réglez Input Format sur mpegts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne den Haken bei Local File. Füge die Adresse in Input ein und setze Input Format auf mpegts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarque Local File. Cole o endereço em Input e defina Input Format como mpegts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾选 Local File。把地址粘贴到 Input，并将 Input Format 设为 mpegts。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Local File のチェックを外してください。アドレスを Input に貼り付け、Input Format を mpegts にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Local File 선택을 해제하세요. 주소를 Input에 붙여넣고 Input Format을 mpegts로 설정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимите отметку с Local File. Вставьте адрес в Input и установите Input Format в mpegts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Local File işaretini kaldırın. Adresi Input'a yapıştırın ve Input Format'ı mpegts yapın."
          }
        }
      }
    },
