        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 휴대전화에서 아직 허용되지 않았습니다. 휴대전화 잠금을 해제하고 허용을 탭하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac ещё не разрешён на телефоне. Разблокируйте телефон и нажмите «Разрешить»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'e telefonda henüz izin verilmedi. Telefonun kilidini açın ve İzin Ver'e dokunun."
          }
        }
      }
    },
