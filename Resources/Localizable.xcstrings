    "Shortcuts are listed as they are in the menu bar. Changing them arrives in a later version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts are listed as they are in the menu bar. Changing them arrives in a later version."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan ditampilkan sama seperti di bilah menu. Mengubahnya hadir di versi berikutnya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos se muestran como en la barra de menús. Poder cambiarlos llegará en una versión posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis sont listés comme dans la barre des menus. Pouvoir les changer arrivera dans une version ultérieure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle werden wie in der Menüleiste aufgelistet. Ändern ist in einer späteren Version möglich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos são listados como na barra de menus. Poder alterá-los chega em uma versão futura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键与菜单栏中的一致。更改功能将在后续版本提供。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットはメニューバーと同じ内容で一覧表示されます。変更は今後のバージョンで対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키는 메뉴 막대와 같게 표시됩니다. 변경은 이후 버전에서 제공됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания перечислены так же, как в строке меню. Их изменение появится в одной из следующих версий."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar menü çubuğundaki gibi listelenir. Değiştirme sonraki bir sürümde gelecek."
          }
        }
      }
    },
