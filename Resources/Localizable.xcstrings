    "The app is already installed with a different signature. Uninstall it on the phone first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is already installed with a different signature. Uninstall it on the phone first."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi sudah terpasang dengan tanda tangan berbeda. Hapus dulu di ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ya está instalada con otra firma. Desinstálala primero en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app est déjà installée avec une autre signature. Désinstallez-la d’abord sur le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
