    "Quitting now would leave the video unfinished. Stop the recording and save it first?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now would leave the video unfinished. Stop the recording and save it first?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar sekarang akan membuat video tidak selesai. Hentikan rekaman dan simpan dulu?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales ahora, el vídeo quedará sin terminar. ¿Detener la grabación y guardarla primero?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter maintenant laisserait la vidéo inachevée. Arrêter l’enregistrement et l’enregistrer d’abord ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden würde das Video unvollendet lassen. Aufnahme stoppen und zuerst sichern?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair agora deixaria o vídeo inacabado. Parar a gravação e salvá-la primeiro?"
          }
        }
      }
    },
