        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключает звонки и баннеры на телефоне на время игры"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken telefondaki aramaları ve bannerları sessize alır"
          }
        }
      }
    },
    "Silence or restore the phone's sound on this Mac": {
      "extractionState": "manual",
