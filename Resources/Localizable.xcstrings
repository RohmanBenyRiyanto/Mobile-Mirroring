    "No debug apps found on the phone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No debug apps found on the phone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada aplikasi debug di HP"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps de depuración en el teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app de débogage sur le téléphone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Debug-Apps auf dem Telefon gefunden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app de depuração encontrado no celular"
          }
        }
      }
    },
    "See the contents of an app's HTTP and HTTPS calls. Only debug builds can be looked into, and no certificate is needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the contents of an app's HTTP and HTTPS calls. Only debug builds can be looked into, and no certificate is needed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat isi panggilan HTTP dan HTTPS sebuah aplikasi. Hanya build debug yang bisa diintip, dan tanpa sertifikat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el contenido de las llamadas HTTP y HTTPS de una app. Solo se pueden inspeccionar compilaciones de depuración y no hace falta certificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez le contenu des appels HTTP et HTTPS d’une app. Seules les versions de débogage peuvent être inspectées, sans certificat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh den Inhalt der HTTP- und HTTPS-Aufrufe einer App. Nur Debug-Builds lassen sich untersuchen, ein Zertifikat ist nicht nötig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o conteúdo das chamadas HTTP e HTTPS de um app. Só builds de depuração podem ser inspecionadas, e nenhum certificado é necessário."
          }
        }
      }
    },
    "Turn on “Send traffic through this Mac”, or look inside a debug app, to see requests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Send traffic through this Mac”, or look inside a debug app, to see requests."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan “Kirim lalu lintas lewat Mac ini”, atau intip aplikasi debug, untuk melihat request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa “Enviar el tráfico a través de este Mac” o inspecciona una app de depuración para ver solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Envoyer le trafic via ce Mac » ou inspectez une app de débogage pour voir les requêtes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Datenverkehr über diesen Mac senden“ oder untersuche eine Debug-App, um Anfragen zu sehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative “Enviar o tráfego por este Mac” ou inspecione um app de depuração para ver solicitações."
          }
        }
      }
    },
    "Through the Mac, HTTPS calls show only the address. To see their contents, look inside a debug app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Through the Mac, HTTPS calls show only the address. To see their contents, look inside a debug app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewat Mac, panggilan HTTPS hanya menampilkan alamat. Untuk melihat isinya, intip aplikasi debug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A través del Mac, las llamadas HTTPS solo muestran la dirección. Para ver su contenido, inspecciona una app de depuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Via le Mac, les appels HTTPS n’affichent que l’adresse. Pour voir leur contenu, inspectez une app de débogage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über den Mac zeigen HTTPS-Aufrufe nur die Adresse. Um ihren Inhalt zu sehen, untersuche eine Debug-App."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo Mac, as chamadas HTTPS mostram só o endereço. Para ver o conteúdo, inspecione um app de depuração."
          }
        }
      }
    },
    "Android Studio was not found. Looking inside an app uses the inspector that comes with Android Studio, so install it in Applications.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio was not found. Looking inside an app uses the inspector that comes with Android Studio, so install it in Applications."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio tidak ditemukan. Mengintip isi aplikasi memakai inspektor bawaan Android Studio, jadi pasang di folder Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró Android Studio. Inspeccionar una app usa el inspector que viene con Android Studio, así que instálalo en Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio est introuvable. Inspecter une app utilise l’inspecteur fourni avec Android Studio, installez-le donc dans Applications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio wurde nicht gefunden. Das Untersuchen einer App nutzt den Inspektor von Android Studio, installiere es daher im Ordner Programme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android Studio não foi encontrado. Inspecionar um app usa o inspetor que vem com o Android Studio, então instale-o em Aplicativos."
          }
        }
      }
    },
