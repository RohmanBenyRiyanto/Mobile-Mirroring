        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A consulta não é SQL válido. Verifique vírgulas, aspas e palavras-chave."
          }
        }
      }
    },
    "The recording is saved first. The window returns to the Connect screen.": {
