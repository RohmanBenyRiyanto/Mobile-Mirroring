    "The app is already installed with a different signature. Uninstall it on the phone first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is already installed with a different signature. Uninstall it on the phone first."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi sudah terpasang dengan tanda tangan berbeda. Hapus dulu di ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ya está instalada con otra firma. Desinstálala primero en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app est déjà installée avec une autre signature. Désinstallez-la d’abord sur le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist bereits mit einer anderen Signatur installiert. Deinstalliere sie zuerst auf dem Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app já está instalado com outra assinatura. Desinstale-o primeiro no celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已用不同的签名安装。请先在手机上卸载它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはすでに別の署名でインストールされています。先にスマートフォンでアンインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 이미 다른 서명으로 설치되어 있습니다. 먼저 휴대전화에서 삭제하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение уже установлено с другой подписью. Сначала удалите его на телефоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama zaten farklı bir imzayla yüklü. Önce telefonda kaldırın."
          }
        }
      }
    },
