    "This app is not debuggable, so Android does not let any tool read its files. Only debug builds can be opened.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not debuggable, so Android does not let any tool read its files. Only debug builds can be opened."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini tidak debuggable, jadi Android tidak mengizinkan alat apa pun membaca filenya. Hanya build debug yang bisa dibuka."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no es depurable, así que Android no deja que ninguna herramienta lea sus archivos. Solo se pueden abrir compilaciones de depuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n’est pas débogable, donc Android ne laisse aucun outil lire ses fichiers. Seules les versions de débogage peuvent être ouvertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist nicht debuggable, daher lässt Android kein Werkzeug ihre Dateien lesen. Nur Debug-Builds können geöffnet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não é depurável, então o Android não deixa nenhuma ferramenta ler seus arquivos. Só builds de depuração podem ser abertas."
          }
        }
      }
    },
    "This app needs a newer version of Android than the phone has.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app needs a newer version of Android than the phone has."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini butuh Android yang lebih baru dari yang ada di ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app necesita una versión de Android más reciente que la del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app nécessite une version d’Android plus récente que celle du téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App benötigt eine neuere Android-Version als das Telefon hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app precisa de uma versão do Android mais nova que a do celular."
          }
        }
      }
    },
    "This is an HTTPS connection. Its contents are encrypted between the app and the server, so only the address and size are known.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an HTTPS connection. Its contents are encrypted between the app and the server, so only the address and size are known."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini koneksi HTTPS. Isinya terenkripsi antara aplikasi dan server, jadi hanya alamat dan ukurannya yang diketahui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una conexión HTTPS. Su contenido va cifrado entre la app y el servidor, así que solo se conocen la dirección y el tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une connexion HTTPS. Son contenu est chiffré entre l’app et le serveur, donc seuls l’adresse et la taille sont connues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine HTTPS-Verbindung. Ihr Inhalt ist zwischen App und Server verschlüsselt, daher sind nur Adresse und Größe bekannt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma conexão HTTPS. O conteúdo é criptografado entre o app e o servidor, então só o endereço e o tamanho são conhecidos."
          }
        }
      }
    },
    "This lets your Mac see and control the phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lets your Mac see and control the phone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memungkinkan Mac melihat dan mengendalikan ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto permite que tu Mac vea y controle el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela permet à votre Mac de voir et de contrôler le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kann dein Mac das Telefon sehen und steuern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso permite que seu Mac veja e controle o celular."
          }
        }
      }
    },
    "This screen shows no elements (games usually draw everything themselves).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen shows no elements (games usually draw everything themselves)."
