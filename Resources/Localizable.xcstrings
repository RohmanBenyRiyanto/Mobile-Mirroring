    "Android keeps these settings hidden until you ask for them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android keeps these settings hidden until you ask for them."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android menyembunyikan pengaturan ini sampai Anda memintanya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android mantiene estos ajustes ocultos hasta que los pidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android masque ces réglages tant que vous ne les demandez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android blendet diese Einstellungen aus, bis du sie anforderst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android mantém essas configurações ocultas até você pedir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 默认隐藏这些设置，直到你主动开启。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android はこれらの設定を、求められるまで非表示にしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android는 요청하기 전까지 이 설정을 숨깁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android скрывает эти настройки, пока вы их не запросите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android bu ayarları siz isteyene kadar gizli tutar."
          }
        }
      }
