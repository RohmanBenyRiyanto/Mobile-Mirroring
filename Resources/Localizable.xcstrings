          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tombol ke keymap dulu; tombol kontroler lalu bisa dihubungkan ke tombol keyboard mana pun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade botones al mapa de teclas; después podrás asignar un botón del mando a cualquiera de sus teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord des boutons à la configuration des touches ; un bouton de manette pourra ensuite être lié à l’une de leurs touches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst Tasten zur Tastenbelegung hinzu; danach lässt sich eine Controller-Taste an jede ihrer Tasten binden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione botões ao mapa de teclas primeiro; depois um botão do controle poderá ser ligado a qualquer uma das teclas deles."
