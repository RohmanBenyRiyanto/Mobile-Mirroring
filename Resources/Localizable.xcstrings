    "The query is not valid SQL. Check commas, quotes and keywords.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The query is not valid SQL. Check commas, quotes and keywords."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Query bukan SQL yang valid. Periksa koma, tanda kutip, dan kata kunci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consulta no es SQL válido. Revisa comas, comillas y palabras clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête n’est pas du SQL valide. Vérifiez les virgules, les guillemets et les mots-clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abfrage ist kein gültiges SQL. Prüfe Kommas, Anführungszeichen und Schlüsselwörter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A consulta não é SQL válido. Verifique vírgulas, aspas e palavras-chave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该查询不是有效的 SQL。请检查逗号、引号和关键字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クエリは有効な SQL ではありません。カンマ、引用符、キーワードを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쿼리가 올바른 SQL이 아닙니다. 쉼표, 따옴표, 키워드를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос не является допустимым SQL. Проверьте запятые, кавычки и ключевые слова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgu geçerli SQL değil. Virgülleri, tırnakları ve anahtar sözcükleri kontrol edin."
          }
        }
      }
    },
