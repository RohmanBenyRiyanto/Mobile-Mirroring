    "Join the phone to the Wi-Fi this Mac uses, then try again. Guest networks often block this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the phone to the Wi-Fi this Mac uses, then try again. Guest networks often block this."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan ponsel ke Wi-Fi yang dipakai Mac ini, lalu coba lagi. Jaringan tamu sering memblokirnya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el teléfono al Wi-Fi que usa este Mac e inténtalo de nuevo. Las redes de invitados suelen bloquearlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez le téléphone au Wi-Fi utilisé par ce Mac, puis réessayez. Les réseaux invités bloquent souvent cela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde das Telefon mit dem WLAN, das dieser Mac nutzt, und versuche es erneut. Gastnetzwerke blockieren das oft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o celular ao Wi-Fi que este Mac usa e tente de novo. Redes de convidados costumam bloquear isso."
          }
        }
      }
    },
