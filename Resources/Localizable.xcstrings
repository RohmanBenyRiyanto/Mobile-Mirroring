    "The query is not valid SQL. Check commas, quotes and keywords.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The query is not valid SQL. Check commas, quotes and keywords."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Query bukan SQL yang valid. Periksa koma, tanda kutip, dan kata kunci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consulta no es SQL válido. Revisa comas, comillas y palabras clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête n’est pas du SQL valide. Vérifiez les virgules, les guillemets et les mots-clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
