    "Unlock the phone and tap Allow. Tick “Always allow from this computer”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the phone and tap Allow. Tick “Always allow from this computer”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci ponsel dan ketuk Izinkan. Centang “Selalu izinkan dari komputer ini”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el teléfono y toca Permitir. Marca “Permitir siempre desde este ordenador”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez le téléphone et appuyez sur Autoriser. Cochez « Toujours autoriser depuis cet ordinateur »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre das Telefon und tippe auf Erlauben. Hake „Von diesem Computer immer erlauben“ an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o celular e toque em Permitir. Marque “Sempre permitir neste computador”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁手机并点按“允许”。勾选“始终允许来自这台计算机”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのロックを解除して「許可」をタップしてください。「このコンピュータからのアクセスを常に許可」にチェックを入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화 잠금을 해제하고 허용을 탭하세요. '이 컴퓨터에서 항상 허용'을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте телефон и нажмите «Разрешить». Отметьте «Всегда разрешать с этого компьютера»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun kilidini açın ve İzin Ver'e dokunun. “Bu bilgisayardan her zaman izin ver”i işaretleyin."
          }
        }
      }
    },
