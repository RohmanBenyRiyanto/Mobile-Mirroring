    "Each mode keeps its own list. Disconnect and the hide button are always on the rail.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each mode keeps its own list. Disconnect and the hide button are always on the rail."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap mode punya daftarnya sendiri. Disconnect dan tombol sembunyi selalu ada di rail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modo tiene su propia lista. Desconectar y el botón de ocultar siempre están en la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mode a sa propre liste. Déconnecter et le bouton masquer sont toujours dans la barre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Modus hat seine eigene Liste. Trennen und die Ausblenden-Taste sind immer in der Leiste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modo tem sua própria lista. Desconectar e o botão de ocultar ficam sempre na barra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种模式都有自己的列表。“断开连接”和隐藏按钮始终在控制栏上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モードごとに専用のリストがあります。切断と非表示ボタンは常にバーにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 모드에는 자체 목록이 있습니다. 연결 해제와 숨기기 버튼은 항상 바에 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого режима свой список. «Отключить» и кнопка скрытия всегда на панели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her modun kendi listesi vardır. Bağlantıyı Kes ve gizleme düğmesi her zaman çubuktadır."
          }
        }
      }
    },
