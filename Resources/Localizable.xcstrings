    "Layout bounds and overdraw apply to apps the next time they open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout bounds and overdraw apply to apps the next time they open."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas layout dan overdraw berlaku saat aplikasi dibuka lagi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites de diseño y el sobredibujado se aplican a las apps la próxima vez que se abran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites de mise en page et le surdessin s’appliquent aux apps à leur prochaine ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Layoutgrenzen und Überzeichnung gelten für Apps beim nächsten Öffnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites de layout e sobredesenho valem para os apps na próxima vez que abrirem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局边界和过度绘制将在应用下次打开时生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト境界とオーバードローは、アプリを次に開いたときに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃 경계와 오버드로는 앱을 다음에 열 때 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Границы макета и перерисовка применятся к приложениям при следующем открытии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşim sınırları ve aşırı çizim uygulamalara bir sonraki açılışta uygulanır."
          }
        }
      }
    },
