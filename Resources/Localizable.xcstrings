    "HTTPS calls show only the address. Their contents stay encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS calls show only the address. Their contents stay encrypted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panggilan HTTPS hanya menampilkan alamat. Isinya tetap terenkripsi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas HTTPS solo muestran la dirección. Su contenido sigue cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels HTTPS n’affichent que l’adresse. Leur contenu reste chiffré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS-Aufrufe zeigen nur die Adresse. Ihr Inhalt bleibt verschlüsselt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chamadas HTTPS mostram só o endereço. O conteúdo continua criptografado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 请求只显示地址，其内容保持加密。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 通信ではアドレスのみ表示されます。内容は暗号化されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 호출은 주소만 표시됩니다. 내용은 암호화된 상태로 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вызовов HTTPS виден только адрес. Их содержимое остаётся зашифрованным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS çağrıları yalnızca adresi gösterir. İçerikleri şifreli kalır."
          }
        }
      }
    },
