    "This app is not debuggable, so Android does not let any tool read its files. Only debug builds can be opened.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not debuggable, so Android does not let any tool read its files. Only debug builds can be opened."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini tidak debuggable, jadi Android tidak mengizinkan alat apa pun membaca filenya. Hanya build debug yang bisa dibuka."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no es depurable, así que Android no deja que ninguna herramienta lea sus archivos. Solo se pueden abrir compilaciones de depuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n’est pas débogable, donc Android ne laisse aucun outil lire ses fichiers. Seules les versions de débogage peuvent être ouvertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist nicht debuggable, daher lässt Android kein Werkzeug ihre Dateien lesen. Nur Debug-Builds können geöffnet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não é depurável, então o Android não deixa nenhuma ferramenta ler seus arquivos. Só builds de depuração podem ser abertas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用不可调试，因此 Android 不允许任何工具读取其文件。只有调试版本才能打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはデバッグ可能ではないため、Android はツールによるファイルの読み取りを許可しません。デバッグビルドのみ開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 디버그할 수 없어서 Android가 어떤 도구도 파일을 읽지 못하게 합니다. 디버그 빌드만 열 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение не отлаживаемое, поэтому Android не даёт ни одному инструменту читать его файлы. Можно открыть только отладочные сборки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama hata ayıklanabilir değil, bu yüzden Android hiçbir aracın dosyalarını okumasına izin vermez. Yalnızca hata ayıklama derlemeleri açılabilir."
          }
        }
      }
    },
    "This app needs a newer version of Android than the phone has.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app needs a newer version of Android than the phone has."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini butuh Android yang lebih baru dari yang ada di ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app necesita una versión de Android más reciente que la del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app nécessite une version d’Android plus récente que celle du téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App benötigt eine neuere Android-Version als das Telefon hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app precisa de uma versão do Android mais nova que a do celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用需要比手机更新的 Android 版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはスマートフォンより新しい Android バージョンが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 휴대전화보다 최신 Android 버전이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этому приложению нужна более новая версия Android, чем на телефоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama, telefondakinden daha yeni bir Android sürümü gerektirir."
          }
        }
      }
    },
    "This is an HTTPS connection. Its contents are encrypted between the app and the server, so only the address and size are known.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an HTTPS connection. Its contents are encrypted between the app and the server, so only the address and size are known."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini koneksi HTTPS. Isinya terenkripsi antara aplikasi dan server, jadi hanya alamat dan ukurannya yang diketahui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una conexión HTTPS. Su contenido va cifrado entre la app y el servidor, así que solo se conocen la dirección y el tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une connexion HTTPS. Son contenu est chiffré entre l’app et le serveur, donc seuls l’adresse et la taille sont connues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine HTTPS-Verbindung. Ihr Inhalt ist zwischen App und Server verschlüsselt, daher sind nur Adresse und Größe bekannt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma conexão HTTPS. O conteúdo é criptografado entre o app e o servidor, então só o endereço e o tamanho são conhecidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 HTTPS 连接。其内容在应用与服务器之间已加密，所以只能知道地址和大小。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは HTTPS 接続です。内容はアプリとサーバーの間で暗号化されているため、アドレスとサイズしか分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 연결입니다. 내용은 앱과 서버 사이에서 암호화되므로 주소와 크기만 알 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это соединение HTTPS. Его содержимое зашифровано между приложением и сервером, поэтому известны только адрес и размер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir HTTPS bağlantısıdır. İçeriği uygulama ile sunucu arasında şifrelidir, bu yüzden yalnızca adres ve boyut bilinir."
          }
        }
      }
    },
    "This lets your Mac see and control the phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lets your Mac see and control the phone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memungkinkan Mac melihat dan mengendalikan ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto permite que tu Mac vea y controle el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela permet à votre Mac de voir et de contrôler le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kann dein Mac das Telefon sehen und steuern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso permite que seu Mac veja e controle o celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样你的 Mac 就能查看和控制手机。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、Mac がスマートフォンを表示・操作できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 Mac에서 휴대전화를 보고 제어할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это позволяет вашему Mac видеть телефон и управлять им."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Mac'inizin telefonu görmesini ve denetlemesini sağlar."
          }
        }
      }
    },
    "This screen shows no elements (games usually draw everything themselves).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen shows no elements (games usually draw everything themselves)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar ini tidak menampilkan elemen (game biasanya menggambar semuanya sendiri)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla no muestra elementos (los juegos suelen dibujar todo por su cuenta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran n’affiche aucun élément (les jeux dessinent généralement tout eux-mêmes)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirm zeigt keine Elemente (Spiele zeichnen meist alles selbst)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tela não mostra elementos (jogos geralmente desenham tudo por conta própria)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此屏幕没有可显示的元素（游戏通常自行绘制所有内容）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面には要素がありません（ゲームは通常すべて自前で描画します）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에는 요소가 없습니다(게임은 보통 모든 것을 직접 그립니다)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом экране нет элементов (игры обычно рисуют всё сами)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekranda öğe yok (oyunlar genellikle her şeyi kendileri çizer)."
          }
        }
      }
    },
    "Tick “Always allow from this computer”.": {
      "extractionState": "manual",
