    "The phone stopped responding. Unplug the cable, plug it in again and unlock the phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone stopped responding. Unplug the cable, plug it in again and unlock the phone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel berhenti merespons. Cabut kabel, colokkan lagi, lalu buka kunci ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono dejó de responder. Desconecta el cable, vuelve a conectarlo y desbloquea el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone ne répond plus. Débranchez le câble, rebranchez-le et déverrouillez le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon reagiert nicht mehr. Ziehe das Kabel ab, stecke es wieder ein und entsperre das Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular parou de responder. Desconecte o cabo, conecte de novo e desbloqueie o celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机已停止响应。请拔下数据线再插上，并解锁手机。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンが応答しなくなりました。ケーブルを抜いて差し直し、スマートフォンのロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화가 응답을 멈췄습니다. 케이블을 뽑았다가 다시 꽂고 휴대전화 잠금을 해제하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон перестал отвечать. Отсоедините кабель, подключите снова и разблокируйте телефон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon yanıt vermeyi durdurdu. Kabloyu çıkarın, tekrar takın ve telefonun kilidini açın."
          }
        }
      }
    },
