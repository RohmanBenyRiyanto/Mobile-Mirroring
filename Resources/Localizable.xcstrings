    "Everything shown on the phone is recorded, including notifications and anything you type. %@ The video is saved in %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything shown on the phone is recorded, including notifications and anything you type. %@ The video is saved in %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang tampil di ponsel direkam, termasuk notifikasi dan apa pun yang Anda ketik. %@ Video disimpan di %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que se muestra en el teléfono se graba, incluidas las notificaciones y lo que escribas. %@ El vídeo se guarda en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui s’affiche sur le téléphone est enregistré, y compris les notifications et ce que vous saisissez. %@ La vidéo est enregistrée dans %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was auf dem Telefon angezeigt wird, wird aufgenommen, auch Mitteilungen und alles, was du tippst. %@ Das Video wird in %@ gesichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que aparece no celular é gravado, incluindo notificações e o que você digita. %@ O vídeo é salvo em %@."
          }
        }
      }
    },
