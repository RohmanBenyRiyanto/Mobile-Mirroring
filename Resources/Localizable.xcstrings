    "If no request appears, open Developer options and choose Revoke USB debugging authorizations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no request appears, open Developer options and choose Revoke USB debugging authorizations."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak ada permintaan, buka Opsi pengembang lalu pilih Cabut otorisasi USB debugging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no aparece ninguna solicitud, abre Opciones de desarrollador y elige Revocar autorizaciones de depuración USB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucune demande n’apparaît, ouvrez les Options pour les développeurs et choisissez Révoquer les autorisations de débogage USB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn keine Anfrage erscheint, öffne die Entwickleroptionen und wähle „USB-Debugging-Autorisierungen widerrufen“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nenhuma solicitação aparecer, abra Opções do desenvolvedor e escolha Revogar autorizações de depuração USB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有出现请求，请打开“开发者选项”并选择“撤消 USB 调试授权”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが表示されない場合は、開発者向けオプションを開き「USB デバッグの許可を取り消す」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 나타나지 않으면 개발자 옵션을 열고 'USB 디버깅 승인 취소'를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если запрос не появился, откройте «Параметры разработчика» и выберите «Отозвать доступ для отладки по USB»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir istek görünmezse Geliştirici seçenekleri'ni açın ve USB hata ayıklama yetkilerini iptal et'i seçin."
          }
        }
      }
    },
