    "Applies the next time you connect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies the next time you connect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku saat sambung berikutnya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica la próxima vez que te conectes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à la prochaine connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt ab der nächsten Verbindung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale na próxima vez que você conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次连接时生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の接続時に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 연결할 때 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применится при следующем подключении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki bağlantıda uygulanır."
          }
        }
      }
    },
    "Apps on the phone lose the internet until you turn it back on. It is switched back on when you disconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps on the phone lose the internet until you turn it back on. It is switched back on when you disconnect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi di ponsel kehilangan internet sampai Anda menyalakannya lagi. Koneksi dinyalakan kembali saat Anda memutus koneksi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps del teléfono no tendrán internet hasta que lo vuelvas a activar. Se reactiva al desconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps du téléphone n’auront plus internet tant que vous ne le réactivez pas. Il est réactivé à la déconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps auf dem Telefon haben kein Internet, bis du es wieder einschaltest. Beim Trennen wird es wieder eingeschaltet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps do celular ficam sem internet até você ativá-la de novo. Ela é reativada ao desconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在重新打开之前，手机上的应用将没有网络。断开连接时会自动恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンに戻すまで、スマートフォンのアプリはインターネットに接続できません。切断するとオンに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 켜기 전까지 휴대전화의 앱은 인터넷을 쓸 수 없습니다. 연결을 끊으면 다시 켜집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У приложений на телефоне не будет интернета, пока вы его не включите. При отключении он включится снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz açana kadar telefondaki uygulamaların interneti kesilir. Bağlantıyı kestiğinizde tekrar açılır."
          }
        }
      }
    },
