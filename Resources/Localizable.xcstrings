    "Uses the USB cable once, then you can unplug it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the USB cable once, then you can unplug it."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memakai kabel USB satu kali, setelah itu kabel boleh dicabut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el cable USB una vez; luego puedes desconectarlo."
          }
        },
        "fr": {
