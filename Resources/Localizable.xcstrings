    "It is installed on %@, replacing the version already there if any. Only install apps you trust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is installed on %@, replacing the version already there if any. Only install apps you trust."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipasang di %@, menggantikan versi yang sudah ada jika ada. Pasang hanya aplikasi yang Anda percaya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se instala en %@ y reemplaza la versión que ya esté allí. Instala solo apps de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est installée sur %@ et remplace la version déjà présente, le cas échéant. N’installez que des apps de confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird auf %@ installiert und ersetzt die dort vorhandene Version, falls es eine gibt. Installiere nur Apps, denen du vertraust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele é instalado em %@, substituindo a versão que já estiver lá. Instale apenas apps de confiança."
          }
        }
      }
    },
