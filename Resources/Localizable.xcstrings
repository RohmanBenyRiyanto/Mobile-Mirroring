    "Lower is faster. Raise it if sound crackles. Applies the next time you connect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower is faster. Raise it if sound crackles. Applies the next time you connect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makin rendah makin cepat. Naikkan jika suara pecah. Berlaku saat sambung berikutnya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos es más rápido. Súbelo si el sonido crepita. Se aplica la próxima vez que te conectes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus bas, plus rapide. Augmentez si le son crépite. S’applique à la prochaine connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger ist schneller. Erhöhe es, wenn der Ton knistert. Gilt ab der nächsten Verbindung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menor é mais rápido. Aumente se o som estalar. Vale na próxima vez que você conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越小越快。如果声音有杂音请调高。下次连接时生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいほど高速です。音が割れる場合は上げてください。次回の接続時に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮을수록 빠릅니다. 소리가 지직거리면 높이세요. 다음에 연결할 때 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше — быстрее. Увеличьте, если звук трещит. Применится при следующем подключении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük değer daha hızlıdır. Ses cızırdarsa artırın. Bir sonraki bağlantıda uygulanır."
          }
        }
      }
    },
