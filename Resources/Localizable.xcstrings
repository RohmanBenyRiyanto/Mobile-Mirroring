    "The phone stopped responding. Unplug the cable, plug it in again and unlock the phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone stopped responding. Unplug the cable, plug it in again and unlock the phone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel berhenti merespons. Cabut kabel, colokkan lagi, lalu buka kunci ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono dejó de responder. Desconecta el cable, vuelve a conectarlo y desbloquea el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone ne répond plus. Débranchez le câble, rebranchez-le et déverrouillez le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon reagiert nicht mehr. Ziehe das Kabel ab, stecke es wieder ein und entsperre das Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular parou de responder. Desconecte o cabo, conecte de novo e desbloqueie o celular."
          }
        }
      }
    },
