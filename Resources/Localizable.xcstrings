    },
    "Could not use the phone's clipboard, copying to Download instead": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard HP tidak bisa dipakai, file disalin ke Download"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not use the phone's clipboard, copying to Download instead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo usar el portapapeles del teléfono; se copia a Descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’utiliser le presse-papiers du téléphone, copie dans Téléchargements à la place"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage des Telefons ließ sich nicht nutzen, es wird stattdessen in Downloads kopiert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar a área de transferência do celular; copiando para Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用手机剪贴板，改为复制到“下载”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのクリップボードを使えなかったため、代わりに Download にコピーします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화 클립보드를 사용할 수 없어 대신 Download로 복사합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось использовать буфер обмена телефона, файлы копируются в «Загрузки»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun panosu kullanılamadı, bunun yerine İndirilenler'e kopyalanıyor"
          }
        }
      },
      "extractionState": "manual"
    },
    "File pasted into the phone. It is also on the phone's clipboard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File pasted into the phone. It is also on the phone's clipboard"
          }
        },
