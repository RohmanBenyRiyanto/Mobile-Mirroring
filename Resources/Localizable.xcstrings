    "Turn on “Send traffic through this Mac” to see the phone’s requests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Send traffic through this Mac” to see the phone’s requests."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan “Kirim lalu lintas lewat Mac ini” untuk melihat permintaan ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa “Enviar el tráfico a través de este Mac” para ver las solicitudes del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Envoyer le trafic via ce Mac » pour voir les requêtes du téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Datenverkehr über diesen Mac senden“, um die Anfragen des Telefons zu sehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative “Enviar o tráfego por este Mac” para ver as solicitações do celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“让流量经过此 Mac”以查看手机的请求。"
          }
