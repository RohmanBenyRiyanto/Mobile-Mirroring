        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화의 요청을 보려면 '트래픽을 이 Mac을 거치게 하기'를 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Пропускать трафик через этот Mac», чтобы видеть запросы телефона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun isteklerini görmek için “Trafiği bu Mac üzerinden gönder”i açın."
