    "Benz Mirror uses the scrcpy server (Apache License 2.0) on the phone. The client on the Mac is written in Swift. Nothing is installed on the phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Benz Mirror uses the scrcpy server (Apache License 2.0) on the phone. The client on the Mac is written in Swift. Nothing is installed on the phone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Benz Mirror memakai server scrcpy (Apache License 2.0) di ponsel. Klien di Mac ditulis dengan Swift. Tidak ada yang dipasang di ponsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Benz Mirror usa el servidor scrcpy (licencia Apache 2.0) en el teléfono. El cliente del Mac está escrito en Swift. No se instala nada en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benz Mirror utilise le serveur scrcpy (licence Apache 2.0) sur le téléphone. Le client sur le Mac est écrit en Swift. Rien n’est installé sur le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benz Mirror nutzt den scrcpy-Server (Apache-Lizenz 2.0) auf dem Telefon. Der Client auf dem Mac ist in Swift geschrieben. Auf dem Telefon wird nichts installiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Benz Mirror usa o servidor scrcpy (licença Apache 2.0) no celular. O cliente no Mac é escrito em Swift. Nada é instalado no celular."
          }
        }
      }
    },
