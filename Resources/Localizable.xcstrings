    "Nothing answered at that address. Check the address and that Wireless debugging is on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing answered at that address. Check the address and that Wireless debugging is on."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menjawab di alamat itu. Periksa alamat dan pastikan Debugging nirkabel aktif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondió en esa dirección. Revisa la dirección y que la depuración inalámbrica esté activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a répondu à cette adresse. Vérifiez l’adresse et que le débogage sans fil est activé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse hat nichts geantwortet. Prüfe die Adresse und ob das drahtlose Debugging aktiv ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondeu nesse endereço. Verifique o endereço e se a depuração sem fio está ativada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址无响应。请检查地址，并确认已开启无线调试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアドレスから応答がありません。アドレスと、ワイヤレスデバッグがオンか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 주소에서 응답이 없습니다. 주소와 무선 디버깅이 켜져 있는지 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этому адресу никто не ответил. Проверьте адрес и что включена беспроводная отладка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adreste kimse yanıt vermedi. Adresi ve Kablosuz hata ayıklamanın açık olduğunu kontrol edin."
          }
        }
      }
    },
