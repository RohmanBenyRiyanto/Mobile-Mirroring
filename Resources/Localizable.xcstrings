    "Keymap copied. Paste it anywhere; others can use Import from Clipboard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keymap copied. Paste it anywhere; others can use Import from Clipboard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keymap disalin. Tempel di mana saja; orang lain bisa memakai Impor dari Papan Klip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa de teclas copiado. Pégalo donde quieras; otros pueden usar Importar desde el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration copiée. Collez-la où vous voulez ; les autres peuvent utiliser Importer depuis le presse-papiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenbelegung kopiert. Füge sie überall ein; andere können „Aus der Zwischenablage importieren“ nutzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa de teclas copiado. Cole onde quiser; outros podem usar Importar da área de transferência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键位映射已拷贝。可粘贴到任何地方；其他人可使用“从剪贴板导入”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーマップをコピーしました。どこにでも貼り付けられます。ほかの人は「クリップボードから読み込む」を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키맵을 복사했습니다. 어디든 붙여넣을 수 있고, 다른 사람은 '클립보드에서 가져오기'를 쓰면 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладка скопирована. Вставьте её куда угодно; другие могут воспользоваться «Импортировать из буфера обмена»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuş haritası kopyalandı. İstediğiniz yere yapıştırın; başkaları Panodan İçe Aktar'ı kullanabilir."
          }
        }
      }
    },
