    "No debug apps found on the phone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No debug apps found on the phone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada aplikasi debug di HP"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps de depuración en el teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app de débogage sur le téléphone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Debug-Apps auf dem Telefon gefunden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app de depuração encontrado no celular"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上没有找到调试应用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンにデバッグアプリが見つかりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화에서 디버그 앱을 찾을 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне нет отладочных приложений"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonda hata ayıklama uygulaması bulunamadı"
          }
        }
      }
    },
    "See the contents of an app's HTTP and HTTPS calls. Only debug builds can be looked into, and no certificate is needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the contents of an app's HTTP and HTTPS calls. Only debug builds can be looked into, and no certificate is needed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat isi panggilan HTTP dan HTTPS sebuah aplikasi. Hanya build debug yang bisa diintip, dan tanpa sertifikat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el contenido de las llamadas HTTP y HTTPS de una app. Solo se pueden inspeccionar compilaciones de depuración y no hace falta certificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez le contenu des appels HTTP et HTTPS d’une app. Seules les versions de débogage peuvent être inspectées, sans certificat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh den Inhalt der HTTP- und HTTPS-Aufrufe einer App. Nur Debug-Builds lassen sich untersuchen, ein Zertifikat ist nicht nötig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o conteúdo das chamadas HTTP e HTTPS de um app. Só builds de depuração podem ser inspecionadas, e nenhum certificado é necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看应用 HTTP 和 HTTPS 请求的内容。只有调试版本可以检查，且无需证书。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの HTTP と HTTPS 通信の内容を確認できます。デバッグビルドのみ対象で、証明書は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 HTTP 및 HTTPS 호출 내용을 봅니다. 디버그 빌드만 살펴볼 수 있고 인증서는 필요 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите содержимое HTTP- и HTTPS-вызовов приложения. Можно заглянуть только в отладочные сборки, сертификат не нужен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulamanın HTTP ve HTTPS çağrılarının içeriğini görün. Yalnızca hata ayıklama derlemeleri incelenebilir ve sertifika gerekmez."
          }
        }
      }
    },
    "Turn on “Send traffic through this Mac”, or look inside a debug app, to see requests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Send traffic through this Mac”, or look inside a debug app, to see requests."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan “Kirim lalu lintas lewat Mac ini”, atau intip aplikasi debug, untuk melihat request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa “Enviar el tráfico a través de este Mac” o inspecciona una app de depuración para ver solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Envoyer le trafic via ce Mac » ou inspectez une app de débogage pour voir les requêtes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Datenverkehr über diesen Mac senden“ oder untersuche eine Debug-App, um Anfragen zu sehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative “Enviar o tráfego por este Mac” ou inspecione um app de depuração para ver solicitações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“让流量经过此 Mac”，或检查调试应用，即可查看请求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「通信をこの Mac 経由にする」をオンにするか、デバッグアプリを調べると、リクエストが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 보려면 '트래픽을 이 Mac을 거치게 하기'를 켜거나 디버그 앱을 살펴보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Пропускать трафик через этот Mac» или загляните в отладочное приложение, чтобы видеть запросы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstekleri görmek için “Trafiği bu Mac üzerinden gönder”i açın veya bir hata ayıklama uygulamasına bakın."
          }
        }
      }
    },
    "Through the Mac, HTTPS calls show only the address. To see their contents, look inside a debug app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Through the Mac, HTTPS calls show only the address. To see their contents, look inside a debug app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewat Mac, panggilan HTTPS hanya menampilkan alamat. Untuk melihat isinya, intip aplikasi debug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A través del Mac, las llamadas HTTPS solo muestran la dirección. Para ver su contenido, inspecciona una app de depuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Via le Mac, les appels HTTPS n’affichent que l’adresse. Pour voir leur contenu, inspectez une app de débogage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über den Mac zeigen HTTPS-Aufrufe nur die Adresse. Um ihren Inhalt zu sehen, untersuche eine Debug-App."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo Mac, as chamadas HTTPS mostram só o endereço. Para ver o conteúdo, inspecione um app de depuração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Mac 时，HTTPS 请求只显示地址。要查看内容，请检查调试应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 経由では、HTTPS 通信はアドレスのみ表示されます。内容を見るには、デバッグアプリを調べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 거치면 HTTPS 호출은 주소만 표시됩니다. 내용을 보려면 디버그 앱을 살펴보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через Mac для вызовов HTTPS виден только адрес. Чтобы увидеть содержимое, загляните в отладочное приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac üzerinden HTTPS çağrıları yalnızca adresi gösterir. İçeriğini görmek için bir hata ayıklama uygulamasına bakın."
          }
        }
      }
    },
    "Android Studio was not found. Looking inside an app uses the inspector that comes with Android Studio, so install it in Applications.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio was not found. Looking inside an app uses the inspector that comes with Android Studio, so install it in Applications."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio tidak ditemukan. Mengintip isi aplikasi memakai inspektor bawaan Android Studio, jadi pasang di folder Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró Android Studio. Inspeccionar una app usa el inspector que viene con Android Studio, así que instálalo en Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio est introuvable. Inspecter une app utilise l’inspecteur fourni avec Android Studio, installez-le donc dans Applications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio wurde nicht gefunden. Das Untersuchen einer App nutzt den Inspektor von Android Studio, installiere es daher im Ordner Programme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android Studio não foi encontrado. Inspecionar um app usa o inspetor que vem com o Android Studio, então instale-o em Aplicativos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Android Studio。检查应用会使用 Android Studio 自带的检查器，请将其安装在“应用程序”中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio が見つかりません。アプリの調査には Android Studio 付属のインスペクタを使うため、「アプリケーション」にインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio를 찾을 수 없습니다. 앱을 살펴보려면 Android Studio에 포함된 검사기를 사용하므로 응용 프로그램에 설치하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio не найдена. Просмотр приложения использует инспектор из Android Studio, поэтому установите её в «Программы»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Studio bulunamadı. Bir uygulamaya bakmak Android Studio ile gelen denetçiyi kullanır, bu yüzden onu Uygulamalar'a yükleyin."
          }
        }
      }
    },
    "This phone's processor (%@) is not supported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's processor (%@) is not supported."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosesor HP ini (%@) belum didukung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesador de este teléfono (%@) no es compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processeur de ce téléphone (%@) n’est pas pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozessor dieses Telefons (%@) wird nicht unterstützt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processador deste celular (%@) não é compatível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机的处理器（%@）不受支持。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンのプロセッサ（%@）には対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대전화의 프로세서(%@)는 지원되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессор этого телефона (%@) не поддерживается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun işlemcisi (%@) desteklenmiyor."
          }
        }
      }
    },
    "%@ is not running. Open it on the phone first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not running. Open it on the phone first."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak berjalan. Buka dulu di HP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se está ejecutando. Ábrela primero en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas en cours d’exécution. Ouvrez-la d’abord sur le téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft nicht. Öffne die App zuerst auf dem Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está em execução. Abra-o primeiro no celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未运行。请先在手机上打开它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は実行されていません。先にスマートフォンで開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실행 중이 아닙니다. 먼저 휴대전화에서 여세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не запущено. Сначала откройте его на телефоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışmıyor. Önce telefonda açın."
          }
        }
      }
    },
    "%@ is not a debug build, so it cannot be looked into. Only apps built as debuggable can.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a debug build, so it cannot be looked into. Only apps built as debuggable can."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bukan build debug, jadi tidak bisa diintip. Hanya aplikasi yang dibuat debuggable yang bisa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es una compilación de depuración, así que no se puede inspeccionar. Solo las apps compiladas como depurables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas une version de débogage, donc elle ne peut pas être inspectée. Seules les apps compilées en débogable le peuvent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kein Debug-Build und kann daher nicht untersucht werden. Nur als debuggable gebaute Apps gehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é uma build de depuração, então não pode ser inspecionado. Só apps compilados como depuráveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是调试版本，因此无法检查。只有构建为可调试的应用才可以。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はデバッグビルドではないため調べられません。デバッグ可能としてビルドされたアプリのみ対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 디버그 빌드가 아니어서 살펴볼 수 없습니다. 디버그 가능으로 빌드된 앱만 가능합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — не отладочная сборка, поэтому в него нельзя заглянуть. Подходят только приложения, собранные как отлаживаемые."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir hata ayıklama derlemesi değil, bu yüzden incelenemez. Yalnızca hata ayıklanabilir olarak derlenen uygulamalar olur."
          }
        }
      }
    },
