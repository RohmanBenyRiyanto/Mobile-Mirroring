        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o celular por Wi-Fi. Verifique se ele está na mesma rede."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过 Wi-Fi 连接手机。请确认它在同一网络中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi でスマートフォンに接続できませんでした。同じネットワークにあるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi로 휴대전화에 연결할 수 없습니다. 같은 네트워크에 있는지 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с телефоном по Wi-Fi. Проверьте, что он в той же сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefona Wi-Fi ile ulaşılamadı. Aynı ağda olduğunu kontrol edin."
          }
        }
      }
    },
    "Could not reconnect. Check the cable and that the phone is unlocked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reconnect. Check the cable and that the phone is unlocked."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat tersambung lagi. Periksa kabel dan pastikan ponsel tidak terkunci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reconectar. Revisa el cable y que el teléfono esté desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnexion impossible. Vérifiez le câble et que le téléphone est déverrouillé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneutes Verbinden fehlgeschlagen. Prüfe das Kabel und ob das Telefon entsperrt ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reconectar. Verifique o cabo e se o celular está desbloqueado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新连接。请检查数据线，并确认手机已解锁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続できませんでした。ケーブルと、スマートフォンのロック解除を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결할 수 없습니다. 케이블과 휴대전화 잠금 해제를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось переподключиться. Проверьте кабель и что телефон разблокирован."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden bağlanılamadı. Kabloyu ve telefonun kilidinin açık olduğunu kontrol edin."
          }
        }
      }
    },
