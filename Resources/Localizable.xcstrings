    "The file could not be read as a database. It may be encrypted or mid-write.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read as a database. It may be encrypted or mid-write."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak bisa dibaca sebagai database. Mungkin terenkripsi atau sedang ditulis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo como base de datos. Puede estar cifrado o escribiéndose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fichier comme base de données. Il est peut-être chiffré ou en cours d’écriture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht als Datenbank gelesen werden. Sie ist evtl. verschlüsselt oder wird gerade geschrieben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não pôde ser lido como banco de dados. Pode estar criptografado ou sendo gravado."
          }
        }
      }
    },
    "The microphone needs Android 11 or newer. The phone's own sound is not sent then.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone needs Android 11 or newer. The phone's own sound is not sent then."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon perlu Android 11 atau lebih baru. Suara ponsel sendiri tidak dikirim saat itu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono requiere Android 11 o posterior. Entonces no se envía el sonido propio del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone nécessite Android 11 ou plus récent. Le son propre du téléphone n’est alors pas envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon benötigt Android 11 oder neuer. Der eigene Ton des Telefons wird dann nicht gesendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone requer Android 11 ou mais recente. O som do próprio celular não é enviado nesse caso."
          }
        }
      }
    },
    "The phone asks once for each new computer.": {
