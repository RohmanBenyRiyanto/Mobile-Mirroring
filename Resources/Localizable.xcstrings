          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing the files for the phone's clipboard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando los archivos para el portapapeles del teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation des fichiers pour le presse-papiers du téléphone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien für die Zwischenablage des Telefons werden vorbereitet"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando os arquivos para a área de transferência do celular"
          }
        },
