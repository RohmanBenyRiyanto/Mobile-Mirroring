    "This Mac is not allowed on the phone yet. Unlock the phone and tap Allow.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is not allowed on the phone yet. Unlock the phone and tap Allow."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini belum diizinkan di ponsel. Buka kunci ponsel lalu ketuk Izinkan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac aún no tiene permiso en el teléfono. Desbloquea el teléfono y toca Permitir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
