    "Silences calls and banners while you play. Turned off again when you disconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silences calls and banners while you play. Turned off again when you disconnect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membisukan panggilan dan banner saat Anda bermain. Dimatikan lagi saat Anda memutus koneksi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia llamadas y avisos mientras juegas. Se desactiva al desconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe appels et bannières pendant que vous jouez. Rétabli à la déconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet Anrufe und Banner beim Spielen stumm. Beim Trennen wieder aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia chamadas e avisos enquanto você joga. Desligado de novo ao desconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏时屏蔽来电和横幅通知。断开连接时会自动关闭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイ中、通話とバナーを消音します。切断するとオフに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임하는 동안 전화와 배너를 무음으로 합니다. 연결을 끊으면 다시 꺼집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключает звонки и баннеры на время игры. При отключении выключается снова."
