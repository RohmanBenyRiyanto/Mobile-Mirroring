    "The connection to the phone was interrupted. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the phone was interrupted. Try again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi ke ponsel terputus. Coba lagi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió la conexión con el teléfono. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au téléphone a été interrompue. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Telefon wurde unterbrochen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com o celular foi interrompida. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与手机的连接被中断。请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンとの接続が中断されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화와의 연결이 중단되었습니다. 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с телефоном прервано. Повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonla bağlantı kesildi. Tekrar deneyin."
          }
        }
      }
    },
    "The file could not be read as a database. It may be encrypted or mid-write.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read as a database. It may be encrypted or mid-write."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak bisa dibaca sebagai database. Mungkin terenkripsi atau sedang ditulis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo como base de datos. Puede estar cifrado o escribiéndose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fichier comme base de données. Il est peut-être chiffré ou en cours d’écriture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht als Datenbank gelesen werden. Sie ist evtl. verschlüsselt oder wird gerade geschrieben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não pôde ser lido como banco de dados. Pode estar criptografado ou sendo gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将该文件作为数据库读取。它可能已加密或正在写入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをデータベースとして読み取れませんでした。暗号化されているか、書き込み中の可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 데이터베이스로 읽을 수 없습니다. 암호화되었거나 기록 중일 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать файл как базу данных. Возможно, он зашифрован или в нём идёт запись."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya veritabanı olarak okunamadı. Şifreli olabilir veya yazılıyor olabilir."
          }
        }
      }
    },
    "The microphone needs Android 11 or newer. The phone's own sound is not sent then.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone needs Android 11 or newer. The phone's own sound is not sent then."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon perlu Android 11 atau lebih baru. Suara ponsel sendiri tidak dikirim saat itu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono requiere Android 11 o posterior. Entonces no se envía el sonido propio del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone nécessite Android 11 ou plus récent. Le son propre du téléphone n’est alors pas envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon benötigt Android 11 oder neuer. Der eigene Ton des Telefons wird dann nicht gesendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone requer Android 11 ou mais recente. O som do próprio celular não é enviado nesse caso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风需要 Android 11 或更高版本。此时不会发送手机自身的声音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクには Android 11 以降が必要です。その場合、スマートフォン自身の音は送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크는 Android 11 이상이 필요합니다. 이 경우 휴대전화 자체 소리는 전송되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для микрофона нужен Android 11 или новее. Собственный звук телефона тогда не передаётся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon Android 11 veya daha yenisini gerektirir. O zaman telefonun kendi sesi gönderilmez."
          }
        }
      }
    },
    "The phone asks once for each new computer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone asks once for each new computer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel bertanya sekali untuk setiap komputer baru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono lo pregunta una vez por cada ordenador nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone le demande une fois pour chaque nouvel ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon fragt einmal für jeden neuen Computer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular pergunta uma vez para cada computador novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机会对每台新电脑询问一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンは新しいコンピュータごとに 1 回確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화는 새 컴퓨터마다 한 번 묻습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон спрашивает один раз для каждого нового компьютера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon her yeni bilgisayar için bir kez sorar."
          }
        }
      }
    },
    "The phone blocks installs over USB. Turn on “Install via USB” in Developer options.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone blocks installs over USB. Turn on “Install via USB” in Developer options."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel memblokir pemasangan lewat USB. Aktifkan “Instal via USB” di Opsi pengembang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono bloquea las instalaciones por USB. Activa “Instalar vía USB” en Opciones de desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone bloque les installations par USB. Activez « Installer via USB » dans les Options pour les développeurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon blockiert Installationen über USB. Aktiviere „Über USB installieren“ in den Entwickleroptionen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular bloqueia instalações por USB. Ative “Instalar via USB” em Opções do desenvolvedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机阻止了通过 USB 安装。请在“开发者选项”中开启“通过 USB 安装”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンが USB 経由のインストールをブロックしています。「開発者向けオプション」で「USB 経由でインストール」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화가 USB를 통한 설치를 차단합니다. 개발자 옵션에서 'USB를 통해 설치'를 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон блокирует установку по USB. Включите «Установка через USB» в параметрах разработчика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon USB üzerinden yüklemeyi engelliyor. Geliştirici seçenekleri'nde “USB ile yükle”yi açın."
          }
        }
      }
    },
