          "stringUnit": {
            "state": "translated",
            "value": "Layar ini tidak menampilkan elemen (game biasanya menggambar semuanya sendiri)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla no muestra elementos (los juegos suelen dibujar todo por su cuenta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran n’affiche aucun élément (les jeux dessinent généralement tout eux-mêmes)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
