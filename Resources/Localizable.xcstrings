    "Liquid Glass is the system's own on macOS 26 and later, imitated before": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass is the system's own on macOS 26 and later, imitated before"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass bawaan sistem di macOS 26 ke atas, ditiru di versi sebelumnya"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass es el propio del sistema en macOS 26 o posterior; antes se imita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass est celui du système sous macOS 26 et plus ; imité avant"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass ist unter macOS 26 und neuer das des Systems, davor wird es nachgeahmt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liquid Glass é o do próprio sistema no macOS 26 e posterior; antes, é imitado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS 26 及更高版本上使用系统自带的 Liquid Glass，更早版本为模拟效果"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26 以降ではシステム本来の Liquid Glass、それ以前は再現表示です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26 이상에서는 시스템 고유의 Liquid Glass, 이전에는 모방한 효과입니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В macOS 26 и новее используется собственный Liquid Glass системы, раньше — имитация"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass, macOS 26 ve sonrasında sistemin kendisidir, öncesinde taklit edilir"
          }
        }
      }
    },
