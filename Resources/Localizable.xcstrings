    "Frame rate and jank come from the app in front. Games that draw on their own may show none.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate and jank come from the app in front. Games that draw on their own may show none."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate dan jank berasal dari aplikasi yang sedang tampil. Game yang menggambar sendiri mungkin tidak menampilkannya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fps y los tirones vienen de la app en primer plano. Los juegos que dibujan por su cuenta pueden no mostrar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fréquence d’images et les saccades viennent de l’app au premier plan. Les jeux qui dessinent eux-mêmes peuvent n’en montrer aucune."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildrate und Ruckler stammen von der App im Vordergrund. Spiele, die selbst zeichnen, zeigen evtl. keine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de quadros e as travadas vêm do app em primeiro plano. Jogos que desenham por conta própria podem não mostrar nenhuma."
          }
        }
      }
    },
    "GIFs are small and short. The picture is shrunk to fit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs are small and short. The picture is shrunk to fit."
