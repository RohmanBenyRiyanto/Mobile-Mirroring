    "Add buttons to the keymap first; a controller button can then be bound to any of their keys.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add buttons to the keymap first; a controller button can then be bound to any of their keys."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tombol ke keymap dulu; tombol kontroler lalu bisa dihubungkan ke tombol keyboard mana pun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade botones al mapa de teclas; después podrás asignar un botón del mando a cualquiera de sus teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord des boutons à la configuration des touches ; un bouton de manette pourra ensuite être lié à l’une de leurs touches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst Tasten zur Tastenbelegung hinzu; danach lässt sich eine Controller-Taste an jede ihrer Tasten binden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione botões ao mapa de teclas primeiro; depois um botão do controle poderá ser ligado a qualquer uma das teclas deles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在键位映射中添加按钮；之后手柄按钮可绑定到其中任意按键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にキーマップへボタンを追加してください。その後、コントローラーのボタンをそのキーに割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 키맵에 버튼을 추가하세요. 그러면 컨트롤러 버튼을 그 키에 연결할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте кнопки в раскладку; потом кнопку геймпада можно привязать к любой из их клавиш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce tuş haritasına düğmeler ekleyin; sonra bir kumanda düğmesi onların herhangi bir tuşuna bağlanabilir."
          }
        }
      }
