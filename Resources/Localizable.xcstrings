    "Could not reach the phone over Wi-Fi. Check that it is on the same network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the phone over Wi-Fi. Check that it is on the same network."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menjangkau ponsel lewat Wi-Fi. Pastikan berada di jaringan yang sama."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo llegar al teléfono por Wi-Fi. Comprueba que está en la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le téléphone en Wi-Fi. Vérifiez qu’il est sur le même réseau."
          }
        },
        "de": {
          "stringUnit": {
