          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi dimulai ulang dan kembali dalam bahasa baru. Rekaman yang sedang berjalan disimpan dulu."
          }
        },
        "es": {
          "stringUnit": {
