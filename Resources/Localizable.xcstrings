        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para juegos que tengan un mapa de teclas. Desactivado: los modos cambian solo cuando tú los cambias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les jeux qui ont une configuration. Désactivé : les modes ne changent que si vous les changez."
