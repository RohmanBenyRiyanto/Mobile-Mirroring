    "Needs Android 12 or later. The real location returns when you pick Real location, press Reset All or disconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Android 12 or later. The real location returns when you pick Real location, press Reset All or disconnect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu Android 12 atau lebih baru. Lokasi asli kembali saat Anda memilih Lokasi asli, menekan Reset Semua, atau memutus koneksi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Android 12 o posterior. La ubicación real vuelve al elegir Ubicación real, pulsar Restablecer todo o desconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Android 12 ou plus récent. La vraie position revient quand vous choisissez Position réelle, appuyez sur Tout réinitialiser ou vous déconnectez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt Android 12 oder neuer. Der echte Standort kehrt zurück, wenn du „Echter Standort“ wählst, „Alles zurücksetzen“ drückst oder trennst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Android 12 ou mais recente. A localização real volta quando você escolhe Localização real, aperta Redefinir tudo ou desconecta."
          }
        }
      }
    },
