    "On Wi-Fi, Maximum can stutter. Game streaming or Balanced is steadier.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Wi-Fi, Maximum can stutter. Game streaming or Balanced is steadier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewat Wi-Fi, Maksimum bisa tersendat. Game streaming atau Seimbang lebih stabil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por Wi-Fi, Máximo puede entrecortarse. Transmisión de juegos o Equilibrado es más estable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En Wi-Fi, Maximum peut saccader. Diffusion de jeu ou Équilibré est plus stable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über WLAN kann Maximum ruckeln. Spiele-Streaming oder Ausgewogen ist stabiler."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Wi-Fi, Máximo pode engasgar. Transmissão de jogos ou Equilibrado é mais estável."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Wi-Fi 下，“最高”可能卡顿。“游戏推流”或“均衡”更稳定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi では「最大」がカクつくことがあります。「ゲームストリーミング」か「バランス」の方が安定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi에서는 '최대'가 끊길 수 있습니다. '게임 스트리밍'이나 '균형'이 더 안정적입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По Wi-Fi режим «Максимум» может подтормаживать. «Игровая трансляция» или «Сбалансированный» стабильнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi'de En Yüksek takılabilir. Oyun yayını veya Dengeli daha kararlıdır."
          }
        }
      }
    },
